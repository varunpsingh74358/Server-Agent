{
  "ControlAgent": {
    "LocalFileModeEnabled": true,
    "DataDirectory": "C:\\ProgramData\\CloudOrc\\ControlAgent",
    "PollIntervalSeconds": 2,
    "FileStabilityMilliseconds": 750,
    "HealthPipeName": "CloudOrc.ControlAgent.Health",
    "WorkerHeartbeatTimeoutSeconds": 30,
    "Validation": {
      "MinTimeoutSeconds": 1,
      "MaxTimeoutSeconds": 3600,
      "DefaultTimeoutSeconds": 30,
      "MaxScriptLength": 32000
    },
    "PowerShellExecEnabled": true
  },
  "BackendConnection": {
    "Enabled": false,
    "Url": "",
    "DevelopmentAllowInsecureWs": false,
    "ConnectTimeoutSeconds": 10,
    "ReconnectInitialDelaySeconds": 2,
    "ReconnectMaximumDelaySeconds": 60,
    "ReconnectJitterMaxMilliseconds": 3000,
    "HeartbeatIntervalSeconds": 15,
    "TelemetryIntervalSeconds": 10,
    "ReconnectFullJitter": true
  },
  "AgentIdentity": {
    "AgentId": "local-test-agent",
    "ServerId": "local-test-server"
  },
  "Activation": {
    "ApiBaseUrl": "",
    "PortalUrl": "",
    "DevelopmentAllowInsecureHttp": false
  },
  "Backup": {
    "Enabled": true,
    "WorkerExecutablePath": null,
    "EngineDirectory": null,
    "ApiBaseUrl": null,
    "SchedulerTickSeconds": 30,
    "ControlPlaneTimeoutSeconds": 30,
    "ProgressEventIntervalSeconds": 30,
    "RetryBaseSeconds": 120,
    "RetryMaxMinutes": 120,
    "ControlPlaneUnreachableRetryMinutes": 5,
    "GrantRenewLeadMinutes": 10,
    "MaxEngineCacheMb": 2048,
    "InboxRetentionDays": 30,
    "JobRetentionDays": 90,
    "DeadOutboxRetentionDays": 7,
    "MaxOutboxRows": 20000,
    "Governor": {
      "SampleIntervalSeconds": 5,
      "DiskLatencyHighMs": 25,
      "DiskLatencyLowMs": 10,
      "SystemCpuHighPercent": 85,
      "SystemCpuLowPercent": 60,
      "MinAvailableMemoryMb": 400,
      "RecoverAfterHealthySamples": 6,
      "ProtectedProcessNames": [
        "tally"
      ]
    }
  },
  "Update": {
    "Enabled": true,
    "MaxPackageBytes": 314572800,
    "HealthTimeoutSeconds": 180,
    "AllowUnsigned": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
